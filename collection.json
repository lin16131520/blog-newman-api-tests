    {
      "name": "查询所有文章",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"状态码是200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"返回100篇文章\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.length).to.eql(100);\r",
              "});\r",
              "\r",
              "pm.test(\"第一条有4个字段\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData[0]).to.have.all.keys(\"userId\", \"id\", \"title\", \"body\");\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{my_host}}/posts",
          "host": [
            "{{my_host}}"
          ],
          "path": [
            "posts"
          ]
        }
      },
      "response": []
    },
