    {
      "name": "按用户查文章",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"状态码是200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"返回10篇文章\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.length).to.eql(10);\r",
              "});\r",
              "\r",
              "pm.test(\"每条的userId和CSV里的一样\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    var expectedId = pm.iterationData.get(\"userId\");\r",
              "    var allMatch = jsonData.every(function (item) {\r",
              "        return item.userId == expectedId;\r",
              "    });\r",
              "    pm.expect(allMatch).to.eql(true);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{my_host}}/posts?userId={{userId}}",
          "host": [
            "{{my_host}}"
          ],
          "path": [
            "posts"
          ],
          "query": [
            {
              "key": "userId",
              "value": "{{userId}}"
            }
          ]
        }
