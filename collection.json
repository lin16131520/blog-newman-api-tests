            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var randomTitle = \"test-\" + Date.now();\r",
              "pm.environment.set(\"random_title\", randomTitle);\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"title\": \"{{random_title}}\",\r\n  \"body\": \"这是文章内容\",\r\n  \"userId\": 1\r\n}\r\n",
